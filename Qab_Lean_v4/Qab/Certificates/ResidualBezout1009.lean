def certificateMatchesRow
    (cert : CollisionBezoutCertificate) (row : ResidualCertificateRow) : Bool :=
  cert.scale₁ = row.r &&
    cert.low₁ = row.low1 &&
    cert.total₁ = row.n &&
    cert.scale₂ = row.s &&
    cert.low₂ = row.low2 &&
